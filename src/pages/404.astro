---
/**
 * Built to dist/404.html — the page the platform serves, with a 404 status, for
 * any address on the site that has no page.
 */
import Base from '../layouts/Base.astro';
---

<Base page="404" title="Page not found">
  <main class="wrap narrow section center">
    <span data-brand-mark="56"></span>
    <p class="eyebrow">404</p>
    <h1>This page does not exist</h1>
    <p class="lede">
      The page you were looking for isn’t part of <span data-brand-name>this site</span>.
    </p>
    <p><a class="button" href="/">Back to home</a></p>
  </main>
</Base>
